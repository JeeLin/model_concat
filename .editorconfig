root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,vue}]
insert_final_newline=true
indent_size=2
max_line_length = 100
quote_type = single

[*.{yml,yaml,json}]
indent_size = 2

[*.rs]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
